# Copy to .env and adjust. Everything works locally with the defaults (no API key, no cost).

# Path to the report PDF (relative to the project root or absolute)
PDF_PATH=iMac_PER_Oct2024.pdf

# Answer generation: none (local extractive answers), gemini, or openai.
# With gemini/openai, the question and retrieved report excerpts are sent to that provider.
LLM_PROVIDER=none

# Gemini (LLM_PROVIDER=gemini), called through its OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI or any OpenAI-compatible server (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Local embeddings (downloaded once to MODEL_CACHE_DIR, ~130 MB). Changing it requires a rebuild.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=artifacts/models

# Retrieval
CHUNK_CHARS=1200
TOP_K=6
# Extractive mode abstains when no passage reaches this cosine similarity
MIN_DENSE_SIMILARITY=0.6
# Extractive mode also abstains when this share of the question's content words never occurs in the report
MAX_ABSENT_RATIO=0.35
